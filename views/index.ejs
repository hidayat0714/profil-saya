<%- include('partials/header', { halaman: halaman, aktif: aktif, profil: profil }) %>

  <!-- ============ HERO ============ -->
  <section class="hero" id="beranda">
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="hero-badge">
          <span class="hero-tag">AJIM // DIGITAL LAB</span>
          <span class="hero-divider" aria-hidden="true"></span>
          <span class="hero-tagline">"Explore. Build. Experiment."</span>
        </div>
        <h1 class="hero-nama">AJIM</h1>
        <p class="hero-role"><span id="heroType"><%= profil.role %></span></p>
        <p class="hero-desc"><%= profil.tagline %></p>
        <div class="hero-actions">
          <a href="#proyek" class="btn btn-primary"><span>ENTER DIGITAL LAB</span><i class="fas fa-arrow-right"></i></a>
          <a href="#proyek" class="btn btn-ghost"><span>VIEW PROJECTS</span><i class="fas fa-briefcase"></i></a>
        </div>
        <div class="hero-social">
          <% profil.sosial.forEach(function(s) { %>
            <a href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= s.nama %>"><i class="<%= s.icon %>"></i></a>
          <% }) %>
        </div>
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number" data-count="<%= profil.proyek.length %>">0</span>
            <span class="stat-label">Projects</span>
          </div>
          <div class="stat-item">
            <span class="stat-number" data-count="<%= profil.keahlian.length %>">0</span>
            <span class="stat-label">Skills</span>
          </div>
          <div class="stat-item">
            <span class="stat-number" data-count="<%= profil.pengalaman.length %>">0</span>
            <span class="stat-label">Experience</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="avatar-wrap">
          <img src="/images/foto-ajim.jpeg" alt="Foto <%= profil.nama %>" class="avatar-img" loading="eager" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'avatar-inisial',textContent:'<%= profil.nama.split(' ').map(function(w){ return w[0] }).join('') %>'}))" />
        </div>
        <div class="orbit-ring" aria-hidden="true"></div>
        <div class="orbit-ring orbit-ring-2" aria-hidden="true"></div>
        <div class="float-chip chip-1"><i class="fab fa-flutter"></i> Flutter</div>
        <div class="float-chip chip-2"><i class="fas fa-microchip"></i> IoT</div>
        <div class="float-chip chip-3"><i class="fab fa-node-js"></i> Node.js</div>
      </div>
    </div>
    <a href="#stations" class="hero-scroll" aria-label="Explore stations"><i class="fas fa-chevron-down"></i></a>
  </section>

  <!-- ============ STATIONS NAVIGATION ============ -->
  <section class="section stations" id="stations" aria-label="Digital Lab Stations">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">01 / Stations</span>
          <h2 class="section-title">Digital Lab Stations</h2>
        </div>
        <p class="section-desc">Navigate through the lab modules</p>
      </div>

      <div class="stations-grid">
        <a href="#profile" class="station-card" data-station="profile">
          <div class="station-icon"><i class="fas fa-user-circle"></i></div>
          <div class="station-content">
            <h3>PROFILE</h3>
            <p>Identity, Education & Experience</p>
          </div>
          <span class="station-arrow"><i class="fas fa-chevron-right"></i></span>
        </a>

        <a href="#proyek" class="station-card" data-station="projects">
          <div class="station-icon"><i class="fas fa-cube"></i></div>
          <div class="station-content">
            <h3>PROJECTS</h3>
            <p>Digital Artifacts & Experiments</p>
          </div>
          <span class="station-arrow"><i class="fas fa-chevron-right"></i></span>
        </a>

        <a href="#keahlian" class="station-card" data-station="skills">
          <div class="station-icon"><i class="fas fa-sitemap"></i></div>
          <div class="station-content">
            <h3>SKILL TREE</h3>
            <p>Interactive Knowledge Map</p>
          </div>
          <span class="station-arrow"><i class="fas fa-chevron-right"></i></span>
        </a>

        <a href="#playground" class="station-card" data-station="playground">
          <div class="station-icon"><i class="fas fa-terminal"></i></div>
          <div class="station-content">
            <h3>PLAYGROUND</h3>
            <p>Terminal, Arcade & Network</p>
          </div>
          <span class="station-arrow"><i class="fas fa-chevron-right"></i></span>
        </a>

        <a href="#kontak" class="station-card" data-station="network">
          <div class="station-icon"><i class="fas fa-network-wired"></i></div>
          <div class="station-content">
            <h3>NETWORK</h3>
            <p>Connect & Collaborate</p>
          </div>
          <span class="station-arrow"><i class="fas fa-chevron-right"></i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ PROFILE ============ -->
  <section class="section" id="profile">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">02 / Identity</span>
          <h2 class="section-title">Profile Access</h2>
        </div>
        <p class="section-desc">System profile data retrieved from memory banks</p>
      </div>

      <div class="profile-grid">
        <div class="profile-main">
          <div class="profile-header">
            <div class="profile-avatar">
              <img src="/images/foto-ajim.jpeg" alt="<%= profil.nama %>" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'avatar-inisial',textContent:'<%= profil.nama.split(' ').map(function(w){ return w[0] }).join('') %>'}))" />
            </div>
            <div class="profile-info">
              <h2><%= profil.nama %></h2>
              <span class="profile-handle">@<%= profil.namaPanggilan.toLowerCase() %></span>
              <p class="profile-tagline"><%= profil.tagline %></p>
            </div>
          </div>

          <div class="profile-panels">
            <div class="profile-panel" id="panelIdentity">
              <div class="panel-header">
                <span class="panel-tag">IDENTITY</span>
                <h3>Core Identity</h3>
              </div>
              <div class="panel-body">
                <div class="data-row"><span class="data-label">Name:</span> <span class="data-value"><%= profil.nama %></span></div>
                <div class="data-row"><span class="data-label">Call Sign:</span> <span class="data-value"><%= profil.namaPanggilan %></span></div>
                <div class="data-row"><span class="data-label">TTL:</span> <span class="data-value"><%= profil.ttl %></span></div>
                <div class="data-row"><span class="data-label">Role:</span> <span class="data-value"><%= profil.role %></span></div>
                <div class="data-row"><span class="data-label">Location:</span> <span class="data-value"><%= profil.lokasi %></span></div>
                <div class="data-row"><span class="data-label">Email:</span> <span class="data-value"><%= profil.email %></span></div>
                <div class="data-row"><span class="data-label">Favorite Color:</span> <span class="data-value"><%= profil.warnaFavorit %></span></div>
                <div class="data-row"><span class="data-label">Interests:</span> <span class="data-value"><%= profil.hobi.join(' • ') %></span></div>
              </div>
            </div>

            <div class="profile-panel" id="panelEducation">
              <div class="panel-header">
                <span class="panel-tag">EDUCATION</span>
                <h3>Academic Records</h3>
              </div>
              <div class="panel-body">
                <ul class="education-list">
                  <% profil.pendidikan.slice().reverse().forEach(function(p) { %>
                  <li class="education-item">
                    <span class="edu-icon"><i class="fas fa-graduation-cap"></i></span>
                    <div class="edu-content">
                      <span class="edu-name"><%= p.nama %></span>
                      <span class="edu-period"><%= p.periode %></span>
                    </div>
                  </li>
                  <% }) %>
                </ul>
              </div>
            </div>

            <div class="profile-panel" id="panelExperience">
              <div class="panel-header">
                <span class="panel-tag">EXPERIENCE</span>
                <h3>Field Operations</h3>
              </div>
              <div class="panel-body">
                <ul class="experience-list">
                  <% profil.pengalaman.forEach(function(p) { %>
                  <li class="experience-item">
                    <span class="exp-icon"><i class="fas fa-briefcase"></i></span>
                    <div class="exp-content">
                      <span class="exp-title"><%= p.judul %></span>
                      <span class="exp-period"><%= p.periode %></span>
                      <span class="exp-desc"><%= p.deskripsi %></span>
                    </div>
                  </li>
                  <% }) %>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="profile-sidebar">
          <div class="sidebar-card">
            <span class="panel-tag">QUICK ACCESS</span>
            <h3>System Links</h3>
            <ul class="quick-links">
              <% profil.sosial.forEach(function(s) { %>
              <li>
                <a href="<%= s.url %>" target="_blank" rel="noopener" class="quick-link">
                  <i class="<%= s.icon %>"></i>
                  <span><%= s.nama %></span>
                  <i class="fas fa-external-link-alt"></i>
                </a>
              </li>
              <% }) %>
            </ul>
          </div>

          <div class="sidebar-card">
            <span class="panel-tag">SYSTEM STATUS</span>
            <h3>Runtime Info</h3>
            <div class="status-grid">
              <div class="status-item">
                <span class="status-dot active"></span>
                <span>System Online</span>
              </div>
              <div class="status-item">
                <span class="status-dot warning"></span>
                <span>Learning Mode</span>
              </div>
              <div class="status-item">
                <span class="status-dot active"></span>
                <span>Database Connected</span>
              </div>
              <div class="status-item">
                <span class="status-dot active"></span>
                <span>API Responsive</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section class="section" id="proyek">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">03 / Artifacts</span>
          <h2 class="section-title">Digital Artifacts</h2>
        </div>
        <p class="section-desc">Deployed projects and experimental builds</p>
      </div>

      <div class="artifacts-grid">
        <% profil.proyek.forEach(function(p, i) { %>
        <article class="artifact-card" data-artifact="<%= i %>">
          <div class="artifact-header">
            <span class="artifact-tag"><i class="<%= p.ikon %>"></i> <%= p.kategori === 'Mycelia' ? 'MYCELIA ECOSYSTEM' : 'WEB APPLICATION' %></span>
            <span class="artifact-id">#<%= String(i + 1).padStart(3, '0') %></span>
          </div>
          <div class="artifact-media">
            <i class="<%= p.ikon %>" aria-hidden="true"></i>
          </div>
          <div class="artifact-body">
            <h3><%= p.nama %></h3>
            <p><%= p.deskripsi %></p>
            <div class="artifact-tech">
              <% p.teknologi.forEach(function(t) { %><span class="tech-chip"><%= t %></span><% }) %>
            </div>
          </div>
          <div class="artifact-footer">
            <button class="btn btn-primary btn-sm artifact-detail" data-proyek="<%= i %>" type="button"><i class="fas fa-eye"></i> Inspect</button>
            <% if (p.download) { %>
              <a href="<%= p.link %>" download class="btn btn-ghost btn-sm"><i class="fas fa-download"></i> Download</a>
            <% } else if (p.link && p.link !== '#') { %>
              <a href="<%= p.link %>" class="btn btn-ghost btn-sm"><i class="fas fa-external-link-alt"></i> View</a>
            <% } %>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============ SKILL TREE ============ -->
  <section class="section" id="keahlian">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">04 / Knowledge</span>
          <h2 class="section-title">Skill Tree</h2>
        </div>
        <p class="section-desc">Interactive technology knowledge map</p>
      </div>

      <div class="skill-tree-container">
        <div class="skill-tree" id="skillTree">
          <% var kat = []; profil.keahlian.forEach(function(k){ if (kat.indexOf(k.kategori) === -1) kat.push(k.kategori); }); %>
          <% kat.forEach(function(kategori, catIndex) { %>
          <div class="skill-branch" data-category="<%= kategori.toLowerCase().replace(/\s+/g, '-') %>">
            <div class="branch-node category-node">
              <div class="node-content">
                <i class="<%= profil.keahlian.filter(function(k){ return k.kategori === kategori; })[0].ikon %>"></i>
                <span><%= kategori %></span>
              </div>
              <div class="node-connector"></div>
            </div>
            <div class="branch-leaves">
              <% profil.keahlian.filter(function(k){ return k.kategori === kategori; }).forEach(function(k, leafIndex) { %>
              <div class="branch-node leaf-node" data-skill="<%= k.nama %>" data-category="<%= kategori %>" data-level="<%= k.level %>">
                <div class="node-content">
                  <i class="<%= k.ikon %>"></i>
                  <span><%= k.nama %></span>
                </div>
                <div class="node-level"><%= k.level %>%</div>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>
        </div>
        <div class="skill-detail" id="skillDetail">
          <div class="detail-placeholder">
            <i class="fas fa-mouse-pointer"></i>
            <p>Click a skill node to inspect</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PLAYGROUND ============ -->
  <section class="section" id="playground">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">05 / Lab</span>
          <h2 class="section-title">Playground</h2>
        </div>
        <p class="section-desc">Experimental modules and interactive systems</p>
      </div>

      <div class="playground-tabs">
        <div class="tab-nav" role="tablist">
          <button class="tab-btn active" role="tab" data-tab="terminal" aria-selected="true">TERMINAL</button>
          <button class="tab-btn" role="tab" data-tab="theme-lab" aria-selected="false">THEME LAB</button>
          <button class="tab-btn" role="tab" data-tab="network-lab" aria-selected="false">NETWORK LAB</button>
        </div>

        <div class="tab-panels">
          <!-- Terminal -->
          <div class="tab-panel active" role="tabpanel" id="terminal" aria-labelledby="terminal-tab">
            <div class="terminal-window">
              <div class="terminal-header">
                <div class="terminal-dots">
                  <span class="dot close"></span>
                  <span class="dot minimize"></span>
                  <span class="dot maximize"></span>
                </div>
                <div class="terminal-title">ajim@digital-lab:~$</div>
              </div>
              <div class="terminal-body" id="terminalBody">
                <div class="terminal-line">
                  <span class="terminal-prompt">ajim@digital-lab:~$</span>
                  <span class="terminal-text">Welcome to AJIM Digital Lab Terminal v1.0</span>
                </div>
                <div class="terminal-line">
                  <span class="terminal-prompt">ajim@digital-lab:~$</span>
                  <span class="terminal-text">Type <span class="cmd">help</span> for available commands</span>
                </div>
                <div class="terminal-line input-line">
                  <span class="terminal-prompt">ajim@digital-lab:~$</span>
                  <input type="text" class="terminal-input" id="terminalInput" autocomplete="off" spellcheck="false" aria-label="Terminal input" />
                </div>
              </div>
            </div>
            <div class="terminal-help">
              <h4>Available Commands:</h4>
              <ul>
                <li><span class="cmd">help</span> — Show this help</li>
                <li><span class="cmd">about</span> — Display profile info</li>
                <li><span class="cmd">projects</span> — List all projects</li>
                <li><span class="cmd">skills</span> — Show skill tree</li>
                <li><span class="cmd">contact</span> — Contact information</li>
                <li><span class="cmd">clear</span> — Clear terminal</li>
                <li><span class="cmd">whoami</span> — Display identity</li>
                <li><span class="cmd">matrix</span> — Toggle matrix rain</li>
                <li><span class="cmd">neofetch</span> — System info</li>
                <li><span class="cmd">games</span> — Arcade menu</li>
                <li><span class="cmd">snake</span> — Main game ular</li>
                <li><span class="cmd">balon</span> — Main game balon udara</li>
                <li><span class="cmd">hs</span> — Lihat highscore</li>
              </ul>
            </div>
          </div>

          <!-- Theme Lab -->
          <div class="tab-panel" role="tabpanel" id="theme-lab" aria-labelledby="theme-lab-tab">
            <div class="lab-panel">
              <h3>Interface Calibration</h3>
              <div class="lab-controls">
                <div class="control-group">
                  <label for="accentIntensity">Accent Intensity</label>
                  <div class="slider-wrap">
                    <input type="range" id="accentIntensity" min="0" max="100" value="50" />
                    <span class="slider-value" id="accentValue">50%</span>
                  </div>
                </div>
                <div class="control-group">
                  <label for="particleDensity">Particle Density</label>
                  <div class="slider-wrap">
                    <input type="range" id="particleDensity" min="0" max="100" value="30" />
                    <span class="slider-value" id="particleValue">30%</span>
                  </div>
                </div>
                <div class="control-group">
                  <label for="glowIntensity">Glow Effect</label>
                  <div class="slider-wrap">
                    <input type="range" id="glowIntensity" min="0" max="100" value="60" />
                    <span class="slider-value" id="glowValue">60%</span>
                  </div>
                </div>
                <div class="control-group">
                  <label>
                    <input type="checkbox" id="reducedMotion" /> Reduced Motion
                  </label>
                </div>
                <div class="control-group">
                  <label>
                    <input type="checkbox" id="highContrast" /> High Contrast
                  </label>
                </div>
                <button class="btn btn-primary btn-sm" id="resetTheme">Reset to Defaults</button>
              </div>
            </div>
          </div>

          <!-- Network Lab -->
          <div class="tab-panel" role="tabpanel" id="network-lab" aria-labelledby="network-lab-tab">
            <div class="lab-panel">
              <h3>Network Topology Visualizer</h3>
              <div class="network-canvas" id="networkCanvas"></div>
              <div class="network-legend">
                <div class="legend-item"><span class="legend-node client"></span> Client</div>
                <div class="legend-item"><span class="legend-node router"></span> Router</div>
                <div class="legend-item"><span class="legend-node server"></span> Server</div>
                <div class="legend-item"><span class="legend-node database"></span> Database</div>
              </div>
              <div class="network-info" id="networkInfo">
                Click a node to inspect
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AJIM_AI ============ -->
  <section class="section" id="ajim-ai">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">06 / Intelligence</span>
          <h2 class="section-title">AJIM_AI</h2>
        </div>
        <p class="section-desc">Experimental conversational interface — placeholder architecture</p>
      </div>

      <div class="ai-interface">
        <div class="ai-header">
          <div class="ai-status">
            <span class="status-indicator offline"></span>
            <span>AJIM_AI v0.1 — Offline Mode</span>
          </div>
          <div class="ai-model">Model: Local Rule-Based (No API)</div>
        </div>
        <div class="ai-chat" id="aiChat">
          <div class="ai-message system">
            <div class="msg-avatar"><i class="fas fa-robot"></i></div>
            <div class="msg-content">
              <p>System initialized. Backend AI integration not configured.</p>
              <p>This is a placeholder interface ready for future API integration.</p>
              <p>Try asking: "What projects have you built?" or "Tell me about your skills"</p>
            </div>
          </div>
        </div>
        <div class="ai-input-area">
          <input type="text" id="aiInput" placeholder="Ask something about this portfolio..." autocomplete="off" />
          <button class="btn btn-primary" id="aiSend"><i class="fas fa-paper-plane"></i></button>
        </div>
        <div class="ai-disclaimer">
          <i class="fas fa-info-circle"></i>
          <span>AI responses are simulated locally. No external API calls are made.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section" id="kontak">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">07 / Network</span>
          <h2 class="section-title">Establish Connection</h2>
        </div>
        <p class="section-desc">Open a channel — transmit your signal</p>
      </div>

      <% if (pesan) { %>
        <div class="alert alert-<%= pesan.tipe %>">
          <i class="fas fa-<%= pesan.tipe === 'sukses' ? 'check-circle' : 'exclamation-circle' %>"></i>
          <%= pesan.teks %>
        </div>
      <% } %>

      <div class="contact-grid">
        <div class="contact-channels">
          <% profil.sosial.forEach(function(s) { %>
          <a href="<%= s.url %>" target="_blank" rel="noopener" class="channel-card">
            <div class="channel-icon"><i class="<%= s.icon %>"></i></div>
            <div class="channel-info">
              <span class="channel-name"><%= s.nama %></span>
              <span class="channel-value"><%= s.nama === 'Email' ? profil.email : s.url.replace(/^https?:\/\/(www\.)?/, '') %></span>
            </div>
            <i class="fas fa-arrow-up-right"></i>
          </a>
          <% }) %>
        </div>

        <form action="/kontak" method="POST" class="transmission-form" id="formKontak">
          <div class="form-header">
            <span class="form-tag">NEW TRANSMISSION</span>
            <h3>Send Signal</h3>
          </div>
          <div class="form-group">
            <label for="nama">IDENTITY</label>
            <input type="text" id="nama" name="nama" placeholder="Your designation" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email">CHANNEL</label>
            <input type="email" id="email" name="email" placeholder="Return frequency" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="subjek">SUBJECT</label>
            <input type="text" id="subjek" name="subjek" placeholder="Transmission subject" />
          </div>
          <div class="form-group">
            <label for="isi">PAYLOAD</label>
            <textarea id="isi" name="isi" rows="5" placeholder="Encode your message..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-satellite"></i> TRANSMIT</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ============ MODAL DETAIL PROYEK ============ -->
  <div class="modal" id="proyekModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-dialog">
      <button class="modal-close" data-close aria-label="Close detail"><i class="fas fa-times"></i></button>
      <div class="modal-header">
        <div class="modal-media"><i class="fas fa-code" id="modalIkon"></i></div>
        <div class="modal-meta">
          <div class="modal-kategori" id="modalKategori"></div>
          <h3 id="modalTitle"></h3>
        </div>
      </div>
      <p class="md-desc" id="modalDesk"></p>
