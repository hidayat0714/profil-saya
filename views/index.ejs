<%- include('partials/header', { halaman: halaman, aktif: aktif, profil: profil }) %>

  <!-- ============ HERO ============ -->
  <section class="hero" id="beranda">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="hero-badge"><span class="dot"></span> Hello, I'm <%= profil.namaPanggilan %> 👋</span>
        <h1 class="hero-nama">Muhamad <span class="grad">Hidayat</span></h1>
        <p class="hero-sub"><span id="heroType"><%= profil.role %></span></p>
        <p class="hero-desc"><%= profil.tagline %></p>
        <div class="hero-actions">
          <a href="#proyek" class="btn btn-primary"><i class="fas fa-arrow-right"></i> Lihat Proyek</a>
          <a href="#kontak" class="btn btn-ghost"><i class="fas fa-paper-plane"></i> Hubungi Saya</a>
        </div>
        <div class="hero-social">
          <% profil.sosial.forEach(function(s) { %>
            <a href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= s.nama %>"><i class="<%= s.icon %>"></i></a>
          <% }) %>
        </div>
      </div>

      <div class="hero-visual">
        <span class="ring" aria-hidden="true"></span>
        <div class="avatar-wrap">
          <img src="/images/foto-ajim.jpeg" alt="Foto <%= profil.nama %>" class="avatar-img" loading="eager" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'avatar-inisial',textContent:'<%= profil.nama.split(' ').map(function(w){ return w[0] }).join('') %>'}))" />
        </div>
        <span class="float-chip chip-1"><i class="fab fa-flutter"></i> Flutter</span>
        <span class="float-chip chip-2"><i class="fas fa-microchip"></i> IoT</span>
        <span class="float-chip chip-3"><i class="fab fa-node-js"></i> Node.js</span>
      </div>
    </div>
    <a href="#tentang" class="hero-scroll" aria-label="Gulir ke bawah"><i class="fas fa-chevron-down"></i></a>
  </section>

  <!-- ============ TENTANG ============ -->
  <section class="section" id="tentang">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">01 / About</span>
          <h2 class="section-title">Tentang Saya</h2>
        </div>
        <p class="section-desc">Mahasiswa Teknik Informatika yang menggabungkan teknologi dengan pertanian.</p>
      </div>

      <div class="bento">
        <div class="bento-card bento-main">
          <h3>Halo, saya <%= profil.nama %> 👋</h3>
          <p><%= profil.ringkasan %></p>
          <div class="bento-info" style="margin-top: 22px;">
            <span class="bi-ikon"><i class="fas fa-leaf"></i></span>
            <div>
              <div class="bi-label">Fokus</div>
              <div class="bi-value">Smart Farming & IoT</div>
            </div>
          </div>
        </div>

        <div class="bento-card">
          <div class="bento-info">
            <span class="bi-ikon"><i class="fas fa-map-marker-alt"></i></span>
            <div>
              <div class="bi-label">Lokasi</div>
              <div class="bi-value"><%= profil.lokasi %></div>
            </div>
          </div>
        </div>

        <div class="bento-card">
          <div class="bento-info">
            <span class="bi-ikon"><i class="fas fa-graduation-cap"></i></span>
            <div>
              <div class="bi-label">Pendidikan</div>
              <div class="bi-value">D4 Teknik Informatika — Politeknik Hasnur</div>
            </div>
          </div>
        </div>

        <div class="bento-card">
          <div class="bento-info">
            <span class="bi-ikon"><i class="fas fa-code"></i></span>
            <div>
              <div class="bi-label">Fokus Utama</div>
              <div class="bi-value">Mobile, Web & Backend</div>
            </div>
          </div>
        </div>

        <div class="bento-card">
          <div class="bento-info">
            <span class="bi-ikon"><i class="fas fa-fish"></i></span>
            <div>
              <div class="bi-label">Minat</div>
              <div class="bi-value"><%= profil.hobi.join(' • ') %></div>
            </div>
          </div>
        </div>

        <div class="bento-stats">
          <div class="stat-card">
            <div class="stat-num"><%= profil.proyek.length %></div>
            <div class="stat-label">Proyek Dibangun</div>
          </div>
          <div class="stat-card">
            <div class="stat-num"><%= profil.keahlian.length %></div>
            <div class="stat-label">Teknologi Dikuasai</div>
          </div>
          <% var expTahun = ''; profil.pengalaman.forEach(function(p){ if(/^\d+/.test(p.periode) && !expTahun) expTahun = p.periode; }); %>
          <% if (expTahun) { %>
          <div class="stat-card">
            <div class="stat-num"><%= expTahun.replace(/[^\d]/g, '') %></div>
            <div class="stat-label">Tahun Budidaya Jamur</div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ KEAHLIAN ============ -->
  <section class="section" id="keahlian">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">02 / Skills</span>
          <h2 class="section-title">Keahlian</h2>
        </div>
        <p class="section-desc">Teknologi yang saya gunakan untuk membangun solusi.</p>
      </div>

      <% var kat = []; profil.keahlian.forEach(function(k){ if (kat.indexOf(k.kategori) === -1) kat.push(k.kategori); }); %>
      <% kat.forEach(function(kategori) { %>
        <div class="skill-group">
          <h3 class="skill-group-title"><%= kategori %></h3>
          <div class="tech-grid">
            <% profil.keahlian.filter(function(k){ return k.kategori === kategori; }).forEach(function(k) { %>
              <div class="tech-card" role="listitem">
                <span class="tech-icon"><i class="<%= k.ikon %>" aria-hidden="true"></i></span>
                <div>
                  <div class="tech-name"><%= k.nama %></div>
                  <div class="tech-cat"><%= k.kategori %></div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- ============ PROYEK ============ -->
  <section class="section" id="proyek">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">03 / Projects</span>
          <h2 class="section-title">Proyek Pilihan</h2>
        </div>
        <p class="section-desc">Proyek yang saya kerjakan — dari IoT hingga pengembangan aplikasi.</p>
      </div>

      <% var mycelia = profil.proyek.filter(function(p){ return p.kategori === 'Mycelia'; }); %>
      <% if (mycelia.length > 1) { %>
      <div class="mycelia-banner">
        <div>
          <h3>Mycelia <span>Ecosystem</span></h3>
          <p>Rangkaian proyek budidaya jamur & smart farming — Smart Farming, Harvest Management, dan IoT.</p>
        </div>
        <div class="mb-chips">
          <% mycelia.forEach(function(p) { %>
            <span class="tag"><i class="<%= p.ikon %>" style="margin-right:6px;"></i><%= p.nama.split('—')[0] %></span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div class="proj-featured">
        <% profil.proyek.forEach(function(p, i) { %>
          <article class="proj-row">
            <% if (i % 2 === 0) { %>
              <div class="proj-media" data-proyek="<%= i %>" role="button" tabindex="0" aria-label="Detail proyek <%= p.nama %>">
                <span class="pm-num"><%= String(i + 1).padStart(2, '0') %></span>
                <i class="<%= p.ikon %> pm-ikon" aria-hidden="true"></i>
                <span class="pm-cat"><%= p.kategori %></span>
              </div>
            <% } %>
            <div class="proj-info">
              <span class="chip"><i class="<%= p.ikon %>"></i> <%= p.kategori === 'Mycelia' ? 'Mycelia Ecosystem' : 'Web' %></span>
              <h3><%= p.nama %></h3>
              <p><%= p.deskripsi %></p>
              <div class="tech-tags">
                <% p.teknologi.forEach(function(t) { %><span class="tag"><%= t %></span><% }) %>
              </div>
              <div class="proj-btns">
                <button class="btn btn-primary btn-sm btn-detail" data-proyek="<%= i %>" type="button"><i class="fas fa-eye"></i> Detail</button>
                <% if (p.download) { %>
                  <a href="<%= p.link %>" download class="btn btn-ghost btn-sm"><i class="fas fa-download"></i> Download APK</a>
                <% } else if (p.link && p.link !== '#') { %>
                  <a href="<%= p.link %>" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-right"></i> Kunjungi</a>
                <% } %>
              </div>
            </div>
            <% if (i % 2 === 1) { %>
              <div class="proj-media" data-proyek="<%= i %>" role="button" tabindex="0" aria-label="Detail proyek <%= p.nama %>">
                <span class="pm-num"><%= String(i + 1).padStart(2, '0') %></span>
                <i class="<%= p.ikon %> pm-ikon" aria-hidden="true"></i>
                <span class="pm-cat"><%= p.kategori %></span>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============ PENDIDIKAN & PENGALAMAN ============ -->
  <section class="section" id="pengalaman">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">04 / Experience</span>
          <h2 class="section-title">Pendidikan & Pengalaman</h2>
        </div>
        <p class="section-desc">Perjalanan akademik dan pengalaman yang membentuk saya.</p>
      </div>

      <div class="timeline">
        <% profil.pengalaman.forEach(function(p) { %>
          <div class="tl-item">
            <span class="tl-node" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
            <div class="tl-card">
              <div class="tl-type">Pengalaman</div>
              <h3 class="tl-title"><%= p.judul %></h3>
              <div class="tl-period"><i class="far fa-calendar" style="margin-right:6px;"></i><%= p.periode %></div>
              <p class="tl-desc"><%= p.deskripsi %></p>
            </div>
          </div>
        <% }) %>

        <% profil.pendidikan.slice().reverse().forEach(function(p) { %>
          <div class="tl-item">
            <span class="tl-node" aria-hidden="true"><i class="fas fa-graduation-cap"></i></span>
            <div class="tl-card">
              <div class="tl-type">Pendidikan</div>
              <h3 class="tl-title"><%= p.nama %></h3>
              <div class="tl-period"><i class="far fa-calendar" style="margin-right:6px;"></i><%= p.periode %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============ KONTAK ============ -->
  <section class="section" id="kontak">
    <div class="container">
      <div class="contact-head">
        <span class="section-label" style="justify-content:center;">05 / Contact</span>
        <h2 class="section-title">Let's build something together.</h2>
        <p>Punya pertanyaan, ide, atau tawaran kerja sama? Saya senang mengobrol — kirim pesan atau hubungi saya lewat media di bawah.</p>
      </div>

      <% if (pesan) { %>
        <div class="alert alert-<%= pesan.tipe %>">
          <i class="fas fa-<%= pesan.tipe === 'sukses' ? 'check-circle' : 'exclamation-circle' %>"></i>
          <%= pesan.teks %>
        </div>
      <% } %>

      <div class="contact-grid">
        <div class="contact-cards">
          <% profil.sosial.forEach(function(s) { %>
            <% if (s.nama === 'Email' || s.nama === 'GitHub' || s.nama === 'WhatsApp' || s.nama === 'LinkedIn') { %>
            <a class="contact-card" href="<%= s.url %>" target="_blank" rel="noopener">
              <span class="cc-ikon"><i class="<%= s.icon %>"></i></span>
              <div class="cc-body">
                <div class="cc-label"><%= s.nama %></div>
                <div class="cc-value"><%= s.nama === 'Email' ? profil.email : s.url.replace(/^https?:\/\/(www\.)?/, '') %></div>
              </div>
            </a>
            <% } %>
          <% }) %>
          <a class="btn btn-primary" href="mailto:<%= profil.email %>" style="justify-content:center;"><i class="fas fa-paper-plane"></i> Get In Touch</a>
        </div>

        <form action="/kontak" method="POST" class="form-card" id="formKontak">
          <div class="form-group">
            <label for="nama">Nama Lengkap</label>
            <input type="text" id="nama" name="nama" placeholder="Nama Anda" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="nama@email.com" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="subjek">Subjek</label>
            <input type="text" id="subjek" name="subjek" placeholder="Subjek pesan" />
          </div>
          <div class="form-group">
            <label for="isi">Pesan</label>
            <textarea id="isi" name="isi" rows="5" placeholder="Tulis pesan Anda..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-paper-plane"></i> Kirim Pesan</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ============ MODAL DETAIL PROYEK ============ -->
  <div class="modal" id="proyekModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-dialog">
      <button class="modal-close" data-close aria-label="Tutup detail"><i class="fas fa-times"></i></button>
      <div class="modal-media"><i class="fas fa-code" id="modalIkon"></i></div>
      <div class="modal-kategori" id="modalKategori"></div>
      <h3 id="modalTitle"></h3>
      <p class="md-desc" id="modalDesk"></p>
      <div class="md-sub">Teknologi</div>
      <div class="tech-tags" id="modalTech"></div>
      <div class="modal-links" id="modalLinks"></div>
    </div>
  </div>

  <script id="proyek-data" type="application/json"><%- JSON.stringify(profil.proyek) %></script>

<%- include('partials/footer', { profil: profil }) %>
